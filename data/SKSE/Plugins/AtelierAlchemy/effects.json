		// Signature effects of AtelierAlchemy.esp, made by no ingredient (Titan's Draught,
		// Dragonblood Tonic). Armor rating in points like Oakflesh; shout recovery in percent,
		// stored as the fraction the Blessing of Talos uses (0.2 = 20% faster).
		"FortifyArmorRating":   { "name": "Fortify Armor Rating", "form": "AtelierAlchemy.esp|0xC00", "base": { "magnitude": 4, "duration": 60 } },
		"FortifyShoutRecovery": { "name": "Fortify Shout Recovery", "form": "AtelierAlchemy.esp|0xC01", "base": { "magnitude": 2, "duration": 60 },
		                          "magnitudeScale": 0.01, "maxMagnitude": 50 },
		// Shadow Draught, Ghostwalk Elixir. Potency lengthens these, like Invisibility (whose
		// ingredients carry 4s); Ethereal is invulnerability, so it stops at 20s (the shout: 8-18s).
		"Muffle":               { "name": "Muffle", "form": "AtelierAlchemy.esp|0xC02", "base": { "magnitude": 1, "duration": 10 } },
		"Ethereal":             { "name": "Ethereal", "form": "AtelierAlchemy.esp|0xC03", "base": { "magnitude": 1, "duration": 2 }, "maxDuration": 20 }
	},

