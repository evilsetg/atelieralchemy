{
	"version": 6,
	"configurePresets": [
		{
			"name": "linux-clangcl",
			"displayName": "Linux -> Windows (clang-cl + xwin)",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"toolchainFile": "${sourceDir}/cmake/toolchain-linux-clangcl.cmake",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"COMMONLIB_ENABLE_IPO": "OFF"
			}
		},
		{
			"name": "windows-msvc",
			"displayName": "Windows (MSVC)",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"CMAKE_C_COMPILER": "cl",
				"CMAKE_CXX_COMPILER": "cl"
			}
		}
	],
	"buildPresets": [
		{ "name": "linux-clangcl", "configurePreset": "linux-clangcl" },
		{ "name": "windows-msvc", "configurePreset": "windows-msvc" }
	]
}
